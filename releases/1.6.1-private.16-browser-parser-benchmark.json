  "method": {
    "scope": "Actual AVC420 envelope assembly, Base64 decoding, bounds checks, NAL inspection and synchronous simulated decode/presentation callbacks; not native H.264 decoding or GPU rendering.",
    "input": "Public generated byte patterns only. 20-byte GAV1 header as its own blob, then independently Base64-encoded 4096-byte payload blobs. Strictly increasing sequences, IDR/SPS/PPS prefix, remainder byte value 1.",
